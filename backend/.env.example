# Copy to backend/.env (or export) — every setting uses the SIYULAH_ prefix.
SIYULAH_ENV=development
# SIYULAH_DATABASE_URL=sqlite:///./data/siyulah.db

# Required in production (generated and stored in data/dev-secrets.json in development)
# SIYULAH_JWT_SECRET=
# SIYULAH_ENCRYPTION_KEY=          # base64 of 32 random bytes (AES-256)

# Where the SPA is served (OAuth redirect target)
SIYULAH_FRONTEND_URL=http://localhost:5173

# Alert delivery — leave empty to run the channel in sandbox mode (recorded, not sent)
# SIYULAH_SMTP_HOST=
# SIYULAH_SMTP_PORT=587
# SIYULAH_SMTP_USER=
# SIYULAH_SMTP_PASSWORD=
# SIYULAH_SMTP_FROM=alerts@example.sa
# SIYULAH_SMS_PROVIDER_URL=       # e.g. an Unifonic / Taqnyat REST endpoint
# SIYULAH_SMS_API_KEY=

# Background refresh + alert evaluation (minutes, 0 = off)
SIYULAH_ALERTS_INTERVAL_MINUTES=360
# Seed the demo company (demo@siyulah.sa / demo1234)
SIYULAH_SEED_DEMO=true
# Freeze "today" for demos/tests (YYYY-MM-DD)
# SIYULAH_TODAY=
